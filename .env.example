TMDB_API_KEY=your_tmdb_key
# Create a free account, then create an API consumer/key at:
# https://www.opensubtitles.com/en/consumers
# Keep these server-only in the repository-root .env.local file. When creating
# the consumer, enable "Under dev" for its temporary 100-download/day test quota
# and leave anonymous downloads disabled. Krzene never purchases a VIP plan.
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key
OPENSUBTITLES_USER_AGENT=Krzene v1
OPENSUBTITLES_USERNAME=your_opensubtitles_username
OPENSUBTITLES_PASSWORD=your_opensubtitles_password
# Optional alternative to username/password when you manage token refresh yourself.
OPENSUBTITLES_TOKEN=
WATCHMODE_API_KEY=your_watchmode_api_key
WATCHMODE_REGION=PH
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Create two responsive display units in AdSense and copy their numeric slot IDs.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-5965941687701015
NEXT_PUBLIC_ADSENSE_SLOT_CATALOG=your_first_ad_slot
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=your_second_ad_slot

# Optional direct-sponsor catalog modal. It stays disabled when no URL is set.
# This is intentionally not an AdSense unit.
NEXT_PUBLIC_CATALOG_SPONSOR_URL=
NEXT_PUBLIC_CATALOG_SPONSOR_TITLE=
NEXT_PUBLIC_CATALOG_SPONSOR_DESCRIPTION=
NEXT_PUBLIC_CATALOG_SPONSOR_CTA=
NEXT_PUBLIC_CATALOG_SPONSOR_IMAGE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=support@krzene.site
