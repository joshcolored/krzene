TMDB_API_KEY=your_tmdb_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Server-only. Prefer a new Supabase secret key (sb_secret_...).
SUPABASE_SECRET_KEY=your_server_secret_key
# Legacy alternative; only one server key is required.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Canonical production origin used for PayMongo return URLs.
APP_URL=https://krzene.site
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_signing_secret
PAYMONGO_PAYMENT_METHODS=qrph

# Create two responsive display units in AdSense and copy their numeric slot IDs.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-5965941687701015
NEXT_PUBLIC_ADSENSE_SLOT_CATALOG=your_first_ad_slot
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=your_second_ad_slot

# Optional direct-sponsor catalog modal. When no URL is set, the timed modal
# promotes Krzene Premium instead. This is intentionally not an AdSense unit.
NEXT_PUBLIC_CATALOG_SPONSOR_URL=
NEXT_PUBLIC_CATALOG_SPONSOR_TITLE=
NEXT_PUBLIC_CATALOG_SPONSOR_DESCRIPTION=
NEXT_PUBLIC_CATALOG_SPONSOR_CTA=
NEXT_PUBLIC_CATALOG_SPONSOR_IMAGE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=support@krzene.site
